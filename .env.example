# Copy this file to .env and populate private values.
DSH_PORT=3080

# Pinned source builds
DSH_SOURCE_URL=https://github.com/n0pe-sled/deepseek-harness.git
DSH_SOURCE_REF=b150a551b8d465e31e418e1b2eaf5e79bbb7d28e
DSH_PLUGINS_SOURCE_URL=https://github.com/n0pe-sled/deepseek-harness-plugins.git
DSH_PLUGINS_SOURCE_REF=530b595efdf787c97474c4d7eee8ee8caa96d6f2
DSH_SKILLS_SOURCE_URL=https://github.com/n0pe-sled/deepseek-harness-skills.git
DSH_SKILLS_SOURCE_REF=ae9880bfc478b30a48e5855385e08ea05bcd5108

# Persistent host directories
CAMPAIGN_DIR=./runtime/campaign
DSH_STATE_DIR=./runtime/dsh
DSH_AGENTS_STATE_DIR=./runtime/agents

# Model credentials
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional OpenAI-compatible DeepSeek route. Keep the private base URL and key
# only in .env. The model appears in the DSH picker when enabled.
ENABLE_RTX_SPARK=0
RTX_SPARK_API_KEY=
RTX_SPARK_BASE_URL=
RTX_SPARK_DISPLAY_NAME=RTX-Spark
RTX_SPARK_MODEL_ID=deepseek-v4-flash-0731
RTX_SPARK_MODEL_NAME=DeepSeek V4 Flash 0731
RTX_SPARK_CONTEXT_WINDOW=1048576
# Default reasoning effort: low, medium, high, or max.
RTX_SPARK_REASONING_EFFORT=max

# Hands-free Ludus API access
ENABLE_LUDUS_MCP=1
LUDUS_URL=
LUDUS_API_KEY=
DSH_LUDUS_MCP_SPEC=@badsectorlabs/ludus-mcp@0.2.0
LUDUS_RANGE_CONNECT=auto
# Optional existing client file; blank fetches /api/v2/user/wireguard.
LUDUS_WIREGUARD_CONFIG=

# Java/JVM reversing
ENABLE_JAVA_MCP=1
JD_MCP_DUO_VERSION=v4.2.5.4
JD_MCP_DUO_SHA256=a68762013ca9375b72d7021a5732dba3743de67f7c25b1834f3579f00672ff3f

# Native/JNI reversing (heavy sidecar)
ENABLE_GHIDRA_MCP=1
GHIDRA_MCP_REF=6f7e7e8988e1efde5dd23372df71fe05c115722e
GHIDRA_JAVA_OPTS=-Xmx4g -XX:+UseG1GC

# PCAP analysis through tshark; output is confined to the campaign.
ENABLE_WIRESHARK_MCP=1
WIRESHARK_MCP_REF=2a8c009fb38723a9212e47d6156cc8a6b2f624c0
