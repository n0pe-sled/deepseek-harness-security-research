# Copy to framework/.env or pass these in the launch environment.
DSH_PORT=3080
DSH_SOURCE_URL=https://github.com/n0pe-sled/deepseek-harness.git
DSH_SOURCE_REF=b150a551b8d465e31e418e1b2eaf5e79bbb7d28e
DSH_PLUGINS_SOURCE_URL=https://github.com/n0pe-sled/deepseek-harness-plugins.git
DSH_PLUGINS_SOURCE_REF=530b595efdf787c97474c4d7eee8ee8caa96d6f2
DSH_SKILLS_SOURCE_URL=https://github.com/n0pe-sled/deepseek-harness-skills.git
DSH_SKILLS_SOURCE_REF=ae9880bfc478b30a48e5855385e08ea05bcd5108
CAMPAIGN_DIR=./runtime/campaign
DSH_STATE_DIR=./runtime/dsh
DSH_AGENTS_STATE_DIR=./runtime/agents

DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# Official Ludus MCP. The API key is not written into a Cordis file.
ENABLE_LUDUS_MCP=1
LUDUS_URL=
LUDUS_API_KEY=
DSH_LUDUS_MCP_SPEC=@badsectorlabs/ludus-mcp@0.2.0

# Download/extract a jd-mcp-duo Linux release here before enabling.
ENABLE_JAVA_MCP=0
JD_MCP_DUO_DIR=./runtime/jd-mcp-duo

# Native/JNI analysis. Start Compose with `--profile native` when enabled.
ENABLE_GHIDRA_MCP=0
GHIDRA_MCP_REF=6f7e7e8988e1efde5dd23372df71fe05c115722e
GHIDRA_MCP_URL=http://127.0.0.1:18089/
GHIDRA_JAVA_OPTS=-Xmx4g -XX:+UseG1GC
